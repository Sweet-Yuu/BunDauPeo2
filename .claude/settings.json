{
  "permissions": {
    "allow": [
      "Bash(unity status)",
      "Bash(unity command package add --identifier \"https://github.com/CoplayDev/unity-mcp.git?path=/MCPForUnity#v10.3.0\" *)",
      "Bash(unity -h)",
      "Bash(unity recompile)",
      "Bash(unity test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Edit(**/*.meta)",
      "Edit(Library/**)",
      "Edit(Logs/**)",
      "Edit(UserSettings/**)",
      "Edit(Temp/**)",
      "Edit(Không động tới/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)"
    ]
  }
}
